# Copy to .env (gitignored) and adjust for your machine.
# UID/GID of your host user so files created in the container are yours:
USER_UID=1000
USER_GID=1000
# GID of the host groups owning /dev/dri nodes (`stat -c %g /dev/dri/renderD128`):
RENDER_GID=110
VIDEO_GID=44
# Fake robot desktop resolution (WxHxDepth):
SIM_RESOLUTION=1920x1080x24
# coturn shared secret for ephemeral TURN credentials (docs/10-security.md).
# Never a per-user password — credentials are minted HMAC(secret, expiry:user).
TURN_SECRET=dev-only-change-me
TURN_REALM=fjarr.local
