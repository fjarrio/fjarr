# Copy to .env (gitignored) and adjust for your machine.
# UID/GID of your host user so files created in the container are yours:
USER_UID=1000
USER_GID=1000
# GID of the host groups owning /dev/dri nodes (`stat -c %g /dev/dri/renderD128`):
RENDER_GID=110
VIDEO_GID=44
# GID owning /var/run/docker.sock (`stat -c %g /var/run/docker.sock`) so the
# browser lab can drive the compose stack from inside dev (docs/25):
DOCKER_GID=999
# Fake robot desktop resolution (WxHxDepth):
SIM_RESOLUTION=1920x1080x24
# coturn shared secret for ephemeral TURN credentials (docs/10-security.md).
# Never a per-user password — credentials are minted HMAC(secret, expiry:user).
TURN_SECRET=dev-only-change-me
TURN_REALM=fjarr.local

# TURN, for the same reason and with the same trap: fjarr-server mints credentials
# from this, and a later `docker compose up` that does not carry the variable recreates
# the sidecar without it — after which relay-only sessions simply never connect, with
# nothing in the log to say why. coturn runs in every profile that runs fjarr-server.
FJARR_TURN_URLS=turn:coturn:3478

# HMAC-signed webhooks fjarr-server posts to the customer's backend
# (docs/09#b-webhooks); the demo backend verifies with the same secret. It lives
# HERE rather than on a `make` line because compose re-reads this file on every
# invocation: a later `docker compose up` that does not carry the variable would
# otherwise recreate fjarr-server without it. Blank the URL if you run the sidecar
# without demo-backend, or it will retry delivery at nothing.
FJARR_WEBHOOK_URL=http://demo-backend:9090/api/fjarr/webhook
FJARR_WEBHOOK_SECRET=dev-only-webhook-secret
# fjarr-server dev hooks (docs/09 contract). The demo-backend signs grants
# with the same HS256 secret; demo-robot presents the same device token.
FJARR_GRANT_HS256_SECRET=dev-only-grant-secret
FJARR_DEV_DEVICE_TOKEN=dev-only-device-token
# The demo exposes the agent's introspection endpoint beyond loopback (docs/24): its token.
FJARR_INTROSPECT_TOKEN=dev-only-introspect-token
# Browser lab (docs/25): extra Chromium flags, and the plain-http origins the
# lab browser treats as secure contexts (getUserMedia). Defaults cover the
# lab page and the demo dashboard on the compose network.
LAB_CHROMIUM_FLAGS=
LAB_INSECURE_ORIGINS=
