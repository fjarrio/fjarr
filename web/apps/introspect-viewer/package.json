{
  "name": "@fjarr/introspect-viewer",
  "private": true,
  "version": "0.1.0",
  "description": "The pipeline viewer served from the agent's introspection endpoint (docs/24): @fjarr/react's <PipelineGraph> on the HTTP pipeline feed, built to static files",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fjarr/core": "workspace:*",
    "@fjarr/react": "workspace:*",
    "d3-graphviz": "^5.6.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
