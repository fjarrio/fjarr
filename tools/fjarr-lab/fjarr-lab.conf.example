# /etc/fjarr-lab.conf (docs/12#lab-machines-and-fjarr-lab)
# The GitHub runner's service, as `./svc.sh install` named it (systemctl list-units 'actions.runner.*').
RUNNER_SERVICE="actions.runner.fjarrio-fjarr.mini-pc.service"
# The CI window, HH:MM-HH:MM (may cross midnight); "off" = online unless reserved. Set it with
# `sudo fjarr-lab window 00:00-06:00`, which also moves the timers.
WINDOW="00:00-06:00"
# How long closing the window or `reserve` waits for a running job before cancelling it.
GRACE_MIN=30
POLL_S=5
