#!/usr/bin/env bash
# fjarr-lab — share a self-hosted runner between people and CI (docs/12#lab-machines-and-fjarr-lab,
# ADR-0033). The runner is online inside the CI window (say 00:00-06:00) and offline otherwise, and a
# person's reservation wins over the window until released. Going offline never kills a job halfway:
# the runner is stopped as soon as it is idle, and only after the grace period does a running job
# get cancelled. Plain bash and systemd, the same on amd64 and arm64 boards.
#
#   fjarr-lab status                show who has the machine, and the next change
#   fjarr-lab reserve               the machine is yours: waits for a running job, then offline
#   fjarr-lab release               back to the schedule
#   fjarr-lab window HH:MM-HH:MM    set the CI window (may cross midnight); `window off` = online unless reserved
#   fjarr-lab apply                 make the runner match the schedule (the timers and the boot unit run this)
#   fjarr-lab reboot                a lab job's reboot: once the runner is idle (the job has ended), reboot
#
# Configuration: /etc/fjarr-lab.conf (RUNNER_SERVICE, WINDOW, GRACE_MIN, POLL_S).
# Tests override FJARR_LAB_CONF, FJARR_LAB_STATE, FJARR_LAB_UNITS and FJARR_LAB_NOW (HH:MM).
set -euo pipefail

CONF=${FJARR_LAB_CONF:-/etc/fjarr-lab.conf}
STATE=${FJARR_LAB_STATE:-/var/lib/fjarr-lab}
UNITS=${FJARR_LAB_UNITS:-/etc/systemd/system}
RUNNER_SERVICE=""
WINDOW="00:00-06:00"
GRACE_MIN=30
POLL_S=5
# shellcheck source=/dev/null
[ -f "$CONF" ] && . "$CONF"

die() { echo "fjarr-lab: $*" >&2; exit 1; }
say() { echo "fjarr-lab: $*"; }

now_hm() { echo "${FJARR_LAB_NOW:-$(date +%H:%M)}"; }
minutes() { local h=${1%:*} m=${1#*:}; echo $((10#$h * 60 + 10#$m)); }
valid_hm() { [[ $1 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; }

# Is HH:MM inside WINDOW ("start-end", end exclusive, may cross midnight)? "off" is never inside.
in_window() {
  local t=$1 w=${2:-$WINDOW}
  [ "$w" = off ] && return 1
  local s e
  s=$(minutes "${w%-*}"); e=$(minutes "${w#*-}"); t=$(minutes "$t")
  if [ "$s" -lt "$e" ]; then [ "$t" -ge "$s" ] && [ "$t" -lt "$e" ]
  elif [ "$s" -gt "$e" ]; then [ "$t" -ge "$s" ] || [ "$t" -lt "$e" ]
  else return 0  # start == end: the whole day
  fi
}

reserved() { [ -f "$STATE/reserved" ]; }

# The decision, from the schedule and the reservation alone: "online" or "offline".
desired() {
  if reserved; then echo offline
  elif [ "$WINDOW" = off ] || in_window "$(now_hm)"; then echo online
  else echo offline
  fi
}

need_service() { [ -n "$RUNNER_SERVICE" ] || die "RUNNER_SERVICE is not set in $CONF"; }
runner_active() { systemctl is-active --quiet "$RUNNER_SERVICE"; }
job_running() { pgrep -f 'Runner.Worker' >/dev/null 2>&1; }

go_online() {
  runner_active && { say "runner already online"; return 0; }
  systemctl start "$RUNNER_SERVICE"
  say "runner online ($RUNNER_SERVICE)"
}

# Offline without killing a job halfway: stop as soon as the runner is idle; only after GRACE_MIN
# is a running job cancelled. There is no "take no new jobs" switch on GitHub's runner, so a job can
# start while this waits — the poll catches the next idle moment.
go_offline() {
  runner_active || { say "runner already offline"; return 0; }
  local waited=0 limit=$((GRACE_MIN * 60))
  while job_running; do
    if [ "$waited" -ge "$limit" ]; then
      say "a job is still running after ${GRACE_MIN} min: stopping the runner, which cancels it"
      break
    fi
    [ "$waited" -eq 0 ] && say "a job is running: waiting for it (up to ${GRACE_MIN} min)"
    sleep "$POLL_S"; waited=$((waited + POLL_S))
  done
  systemctl stop "$RUNNER_SERVICE"
  say "runner offline"
}

next_change() {
  if reserved; then echo "when released"
  elif [ "$WINDOW" = off ]; then echo "none (no window)"
  elif in_window "$(now_hm)"; then echo "offline at ${WINDOW#*-}"
  else echo "online at ${WINDOW%-*}"
  fi
}

cmd_status() {
  need_service
  local who state
  if reserved; then who="reserved by $(cat "$STATE/reserved")"
  elif [ "$(desired)" = online ]; then who="CI (inside the window $WINDOW)"
  else who="free for people (outside the window $WINDOW)"
  fi
  if runner_active; then state="online$(job_running && echo ', running a job' || echo ', idle')"; else state="offline"; fi
  echo "machine:  $who"
  echo "runner:   $RUNNER_SERVICE — $state"
  echo "window:   $WINDOW · grace ${GRACE_MIN} min"
  echo "next:     $(next_change)"
}

cmd_reserve() {
  need_service
  mkdir -p "$STATE"
  echo "${SUDO_USER:-${USER:-root}} since $(date '+%Y-%m-%d %H:%M')" > "$STATE/reserved"
  say "reserved for ${SUDO_USER:-${USER:-root}}"
  go_offline
}

cmd_release() {
  need_service
  rm -f "$STATE/reserved"
  say "released: back to the schedule"
  cmd_apply
}

cmd_apply() {
  need_service
  if [ "$(desired)" = online ]; then go_online; else go_offline; fi
}

# The timers fire at the window's edges; `apply` decides, so a timer that fires during a
# reservation changes nothing.
write_timers() {
  local open=$1 close=$2
  mkdir -p "$UNITS/fjarr-lab-open.timer.d" "$UNITS/fjarr-lab-close.timer.d"
  printf '[Timer]\nOnCalendar=\nOnCalendar=*-*-* %s:00\n' "$open" > "$UNITS/fjarr-lab-open.timer.d/window.conf"
  printf '[Timer]\nOnCalendar=\nOnCalendar=*-*-* %s:00\n' "$close" > "$UNITS/fjarr-lab-close.timer.d/window.conf"
}

cmd_window() {
  local w=${1:-}
  [ -n "$w" ] || die "usage: fjarr-lab window HH:MM-HH:MM | off"
  if [ "$w" != off ]; then
    valid_hm "${w%-*}" && valid_hm "${w#*-}" && [[ $w == *-* ]] || die "not a window: '$w' (HH:MM-HH:MM, e.g. 00:00-06:00)"
    write_timers "${w%-*}" "${w#*-}"
  else
    rm -f "$UNITS/fjarr-lab-open.timer.d/window.conf" "$UNITS/fjarr-lab-close.timer.d/window.conf"
  fi
  if grep -q '^WINDOW=' "$CONF" 2>/dev/null; then
    sed -i "s/^WINDOW=.*/WINDOW=\"$w\"/" "$CONF"
  else
    echo "WINDOW=\"$w\"" >> "$CONF"
  fi
  WINDOW=$w
  [ -n "${FJARR_LAB_NO_SYSTEMD:-}" ] || systemctl daemon-reload
  say "window: $w"
  cmd_apply
}

# A job cannot outlive the reboot it causes, so it asks for one and ends: this waits in the background
# until no job runs (the caller's has finished), takes the runner offline so nothing new starts, and
# reboots. At boot the apply unit brings the runner back if the window is open (docs/15#unattended).
cmd_reboot() {
  need_service
  if [ -z "${FJARR_LAB_FOREGROUND:-}" ]; then
    # The job asking for the reboot: its Runner.Worker, an ancestor of this process. Waiting for that
    # one process (not polling for "no job") takes the runner offline the moment the job ends,
    # before GitHub can hand it the next queued job (the first night, 2026-10-02: verify was queued
    # and taken before the reboot).
    local pid=$$ worker=""
    while [ "$pid" -gt 1 ]; do
      if [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = "Runner.Worker" ]; then worker=$pid; break; fi
      pid=$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null || echo 1)
    done
    FJARR_LAB_FOREGROUND=1 FJARR_LAB_WAIT_PID="$worker" setsid "$0" reboot </dev/null >>"$STATE/reboot.log" 2>&1 &
    say "rebooting once ${worker:+this job (Runner.Worker $worker) has ended}${worker:-the runner is idle} (log: $STATE/reboot.log)"
    return 0
  fi
  local waited=0 limit=$((GRACE_MIN * 60))
  if [ -n "${FJARR_LAB_WAIT_PID:-}" ]; then
    while kill -0 "$FJARR_LAB_WAIT_PID" 2>/dev/null && [ "$waited" -lt $((limit * 5)) ]; do
      sleep 0.2; waited=$((waited + 1))
    done
    systemctl stop "$RUNNER_SERVICE"
    say "$(date -Is) the job has ended: runner offline at once, then reboot"
  else
    sleep "${FJARR_LAB_REBOOT_SETTLE:-3}"
    while job_running && [ "$waited" -lt "$limit" ]; do
      sleep "$POLL_S"; waited=$((waited + POLL_S))
    done
    systemctl stop "$RUNNER_SERVICE"
    say "$(date -Is) runner idle: offline, then reboot"
  fi
  systemctl reboot
}

case "${1:-status}" in
  status) cmd_status ;;
  reserve) cmd_reserve ;;
  release) cmd_release ;;
  window) shift; cmd_window "${1:-}" ;;
  apply) cmd_apply ;;
  reboot) mkdir -p "$STATE"; cmd_reboot ;;
  desired) desired ;;  # for tests and scripts
  -h|--help|help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (status, reserve, release, window, apply, reboot)" ;;
esac
