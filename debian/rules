#!/usr/bin/make -f
# spec: docs/26-robot-install-and-drivers.md#packages · ADR-0031
%:
	dh $@ --buildsystem=cmake+ninja

# debhelper disconnects FetchContent (the Debian norm: no network in a build). Ours fetches the
# pinned json-schema-validator (docs/14, no Ubuntu package) and cargo fetches crates, so the builder
# has network by design (docs/26#releases); the pins, not the sandbox, are what keep it reproducible.
override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DFJARR_BUILD_TESTS=OFF -DFETCHCONTENT_FULLY_DISCONNECTED=OFF

override_dh_auto_build:
	dh_auto_build
	cd signaling && cargo build --release --locked -p fjarr-connect -p fjarr-setup

# The fjarr user comes from debian/fjarr-agent.sysusers. dh_installsysusers is only in the default
# sequence from compat 14, so at 13 it is called here, before the unit that runs as that user.
execute_before_dh_installsystemd:
	dh_installsysusers

# Two units, two policies (docs/26#packages): fjarr-agent.service is enabled by the package and
# waits for its config; fjarr-net.service ships disabled and `net setup` enables it, because a
# tunnel device is only wanted where fjarr.net is configured.
override_dh_installsystemd:
	dh_installsystemd -p fjarr-agent --name=fjarr-net --no-enable --no-start
	dh_installsystemd -p fjarr-agent fjarr-agent.service
	@# The desktop watchdog ships disabled; `setup desktop` enables it (docs/26#fjarr-agent-setup-desktop).
	dh_installsystemd -p fjarr-desktop-wayland --name=fjarr-desktop-watchdog --no-enable --no-start fjarr-desktop-watchdog.timer fjarr-desktop-watchdog.service

# The helper's user unit is enabled by `setup desktop` for the desktop account only; debhelper would
# enable it globally, for every account that ever logs in (docs/26#fjarr-agent-setup-desktop).
override_dh_installsystemduser:

# The tests run in CI against the dev image (make agent-test, signaling-test); a package build
# does not repeat them.
override_dh_auto_test:

override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp
	@test -f web/apps/introspect-viewer/dist/index.html || { echo "the introspection viewer is not built: run make deb, which builds it first"; exit 1; }
	mkdir -p debian/fjarr-agent/usr/share/fjarr/viewer
	cp -a web/apps/introspect-viewer/dist/. debian/fjarr-agent/usr/share/fjarr/viewer/
	@# Not under /usr/share/doc: Ubuntu's minimal and container images drop that path at install.
	install -D -m 0644 packaging/fjarr.toml.example debian/fjarr-agent/usr/share/fjarr/fjarr.toml.example
	install -D -m 0644 packaging/profile.toml debian/fjarr-agent/usr/share/fjarr/profile.toml
	@# The driver catalog `setup` and `drivers` read (docs/26#the-driver-catalog).
	install -D -m 0644 packaging/catalog.toml debian/fjarr-agent/usr/share/fjarr/catalog.toml
	install -D -m 0755 signaling/target/release/fjarr-connect debian/fjarr-tools/usr/bin/fjarr-connect
	@# The setup tool, handed `setup`, `net` and `drivers` by fjarr-agent (docs/26#the-setup-tool).
	install -D -m 0755 signaling/target/release/fjarr-setup debian/fjarr-agent/usr/lib/fjarr/fjarr-setup
	@# The helper's user unit, installed but enabled for no one: `setup desktop` enables it for the
	@# desktop account only (dh_installsystemduser would enable it for every user).
	install -D -m 0644 packaging/systemd/fjarr-desktop-session.service debian/fjarr-desktop-wayland/usr/lib/systemd/user/fjarr-desktop-session.service
