software =
{
  version = "@V@";
  hardware-compatibility: [ "1.0" ];
  fjarr: {
    slot-a: {
      images: ( { filename = "root.raw.zst"; type = "raw"; compressed = "zstd"; installed-directly = true;
                  device = "/dev/disk/by-partuuid/4f8a1c2e-6b1d-4c57-9a0e-2d3f5b7a1101"; sha256 = "@ROOT_SHA@"; } );
