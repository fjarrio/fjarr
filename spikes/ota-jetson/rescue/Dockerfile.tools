# Build and test tools for the Jetson network rescue: ukify with systemd's arm64 EFI stub, depmod,
# and the off-box test bench (QEMU arm64 with AAVMF, dnsmasq, shellcheck). Ubuntu 26.04 is the
# mini-PC's release, so the tests run the dnsmasq and Python versions it runs.
# spec: docs/32-fleet-ota.md#jetson-test-image ("Three rescue layers", item 2)
FROM --platform=linux/amd64 ubuntu:26.04@sha256:c098726dd9b9733f3e885f8de0ef375206a311b0a317eadc40d347b1115fb944
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd-ukify python3 python3-pefile kmod cpio xz-utils zstd file \
      dnsmasq-base curl openssh-client iproute2 nftables shellcheck \
      qemu-system-arm qemu-efi-aarch64 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# The arm64 stub comes from the arm64 build of the same systemd release as ukify.
RUN sed -i '/^Types:/a Architectures: amd64' /etc/apt/sources.list.d/ubuntu.sources \
 && printf '%s\n' 'Types: deb' 'URIs: http://ports.ubuntu.com/ubuntu-ports/' \
      'Suites: resolute resolute-updates resolute-security' 'Components: main universe' \
      'Architectures: arm64' 'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/ports.sources \
 && dpkg --add-architecture arm64 \
 && apt-get update \
 && cd /tmp \
 && apt-get download systemd-boot-efi:arm64 \
 && dpkg-deb -x systemd-boot-efi_*_arm64.deb /tmp/sbe \
 && install -D -m 0644 /tmp/sbe/usr/lib/systemd/boot/efi/linuxaa64.efi.stub /opt/stub/linuxaa64.efi.stub \
 && dpkg-deb -f systemd-boot-efi_*_arm64.deb Version > /opt/stub/VERSION \
 && rm -rf /tmp/sbe /tmp/*.deb /var/lib/apt/lists/*
