# Build context hygiene for docker/agent/Dockerfile (repo-root context, docs/12): sources only.
.git
build/
node_modules/
**/node_modules/
**/dist/
web/e2e/out/
inspiration/
fjarr-private-research/
website/.astro/
# A spike's build output (root-owned apt caches the build cannot read, gigabytes of images).
spikes/*/out/
.env
*.log
# The images are built FROM the .debs (docs/26#releases, ADR-0031): make deb puts them here first.
!dist/deb
