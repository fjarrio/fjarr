---
// Dark/light toggle: Starlight's ThemeSelect override, and the landing page's.
// spec: docs/19-website-and-publishing.md#visual-design
import { Icon } from "@astrojs/starlight/components";
---
<fjarr-theme-toggle>
  <button type="button" aria-label="Switch to light theme" title="Switch theme">
    <Icon name="sun" class="sun" size="1.15rem" />
    <Icon name="moon" class="moon" size="1.15rem" />
  </button>
</fjarr-theme-toggle>

<script>
  class FjarrThemeToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button")!;
      const sync = () => {
        const light = document.documentElement.dataset.theme === "light";
        button.setAttribute("aria-label", light ? "Switch to dark theme" : "Switch to light theme");
      };
      sync();
      button.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("starlight-theme", next); } catch {}
        document.dispatchEvent(new CustomEvent("fjarr:theme", { detail: next }));
      });
      document.addEventListener("fjarr:theme", sync);
    }
  }
  if (!customElements.get("fjarr-theme-toggle")) customElements.define("fjarr-theme-toggle", FjarrThemeToggle);
</script>

<style>
  button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    background: none;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: color 120ms ease, border-color 120ms ease;
  }
  button:hover { color: var(--sl-color-text-accent); border-color: var(--sl-color-hairline-light); }
  /* Show the theme you'd switch to. */
  .sun, .moon { grid-area: 1 / 1; }
  :global(:root[data-theme="light"]) .sun { display: none; }
  :global(:root:not([data-theme="light"])) .moon { display: none; }
</style>
