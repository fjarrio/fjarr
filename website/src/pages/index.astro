---
// fjarr.io landing page — sells the product and guides the project.
// spec: docs/19-website-and-publishing.md#landing-page-content-model — section order, owners
// and claim rules (#claims). The page describes Fjarr as designed, in the present tense, with no
// availability badges (ADR-0042); every number is a row of docs/16-performance-budgets.md#measured
// or a recorded test count, and every command and address it offers works today.

import "../styles/theme.css";
import ThemeInit from "../components/ThemeInit.astro";
import SiteHeader from "../components/SiteHeader.astro";
import NetworkField from "../components/NetworkField.astro";
import FjIcon from "../components/FjIcon.astro";
// The docs' code renderer (Expressive Code, same themes and config), so code looks the same on both.
import { Code, Tabs, TabItem } from "@astrojs/starlight/components";

// The latest published release (apt.fjarr.io stable). Moves with each release, not with main.
const release = "0.1.2";
// Where "Talk to us" goes (docs/19: one address, set here). Empty: those calls to action are not
// rendered — never a guessed address.
const contact = "contact@fjarr.io";
const talk = contact ? `mailto:${contact}` : "";

// Section 4: three pillars (docs/06), then the tools beneath.
const pillars = [
  {
    title: "See and control",
    items: [
      { icon: "camera" as const, name: "Camera video", desc: "Every camera, one encode fanned out to every viewer, adaptive to the link." },
      { icon: "monitor" as const, name: "Remote desktop", desc: "The machine's own desktop, every monitor, unattended after a reboot." },
      { icon: "terminal" as const, name: "Terminal", desc: "A shell in the browser, off until configured, audited when opened." },
      { icon: "mic" as const, name: "Audio", desc: "Hear its microphones, talk through its speaker." },
    ],
  },
  {
    title: "Reach",
    items: [
      { icon: "link" as const, name: "Network link", desc: "A routable address for one machine: ssh, ROS 2, your debugger, your vendor's tools." },
      { icon: "folder" as const, name: "Files", desc: "Its files as a drive, and transfers that survive a flaky LTE link." },
    ],
  },
  {
    title: "Keep it running",
    items: [
      { icon: "refresh" as const, name: "Fleet updates", desc: "The whole robot under one signed release, rolled back when it isn't healthy." },
      { icon: "chart" as const, name: "Telemetry & logs", desc: "Typed sensor streams, and logs that store and forward when offline." },
      { icon: "pulse" as const, name: "Fleet observability", desc: "Versions, host metrics and error rates across the fleet." },
    ],
  },
];

// docs/16#measured — copy, never round into something the table doesn't say. `label` is the plain
// gloss; `detail` keeps the measurement's own terms.
const numbers = [
  { value: "56 ms", label: "from the robot's camera to your screen, on a LAN", detail: "glass-to-glass p50; p95 79 ms" },
  { value: "102 ms", label: "the same through a relay, at the slow end", detail: "p95; p50 69 ms" },
  { value: "52 ms", label: "from your click to seeing it happen on the desktop", detail: "input-to-photon p50; p95 59 ms, real hardware" },
  { value: "11 ms", label: "a keystroke in the terminal, there and back", detail: "budget 150 ms" },
  { value: "~250 Mbps", label: "copying a 1 GiB file over the network link", detail: "246–253 Mbps, hash-verified" },
  { value: "31–33 fps", label: "camera video while a transfer fills the link", detail: "no lost frames" },
];

// Section 8: commands as docs/29 gives them, the visitor's side only.
const tunnelUses = [
  {
    title: "ROS 2 from your desk",
    desc: "DDS discovery crosses the link, so the CLI and rviz2 see the robot's graph.",
    code: "ros2 topic list\nrviz2",
    href: "/29-tunnel-howtos/#ros-2-over-the-link",
  },
  {
    title: "Your debugger, on its process",
    desc: "gdbserver on the robot, gdb or VS Code on your laptop.",
    code: "gdb ./my_node -ex \"target remote <machine>:2345\"",
    href: "/29-tunnel-howtos/#gdbserver-debug-a-process-on-the-robot",
  },
  {
    title: "Its CAN bus on your laptop",
    desc: "Bridged to a virtual interface: SavvyCAN or the vendor's tool sees the bus live.",
    code: "cannelloni -I vcan0 -R <machine> -r 20000 -l 20000\ncandump vcan0",
    href: "/29-tunnel-howtos/#can-the-robots-bus-on-your-laptop-cannelloni",
  },
  {
    title: "Its containers, from your CLI",
    desc: "Your docker client, the machine's engine — logs, exec, restarts.",
    code: "export DOCKER_HOST=ssh://user@<machine>\ndocker logs -f my-node",
    href: "/29-tunnel-howtos/#docker-on-the-robot-from-your-cli",
  },
  {
    title: "Wireshark on its interfaces",
    desc: "A live capture from the robot's network, in the Wireshark on your desk.",
    code: "ssh user@<machine> \\\n  \"sudo tcpdump -i eth0 -U -w - 'not port 22'\" \\\n  | wireshark -k -i -",
    href: "/29-tunnel-howtos/#wireshark-live-capture-from-the-robots-interfaces",
  },
  {
    title: "Any USB device, on your desk",
    desc: "A programmer or USB-serial adapter plugged into the robot appears on your laptop.",
    code: "usbip list -r <machine>\nsudo usbip attach -r <machine> -b 1-2",
    href: "/29-tunnel-howtos/#usbip-any-usb-device-on-your-machine",
  },
];
const connectSession = `$ fjarr-connect login                 # your company's sign-in, in the browser
$ fjarr-connect robot-024
robot-024  100.70.118.224  mtu 1184  up in 0.8 s`;

// Section 6: the updater's steps (docs/32#updater) and what the design promises (docs/32, docs/17 M8).
const runSteps = [
  ["Fetch", "only the chunks it lacked, within today's budget"],
  ["Ready", "charging · not moving · owner chose tonight"],
  ["Prepare", "arm parked, motors off"],
  ["Install", "os → slot B · app · config"],
  ["Switch", "rebooted into slot B"],
  ["Health", "agent back · probes pass"],
  ["Peripherals", "GNSS configuration, verified by read-back"],
  ["Commit", "slot B marked good"],
  ["Firmware", "motor controller over CAN"],
];
const ota: { icon: "seal" | "battery" | "download" | "power" | "chip" | "layers"; title: string; desc: string; cloud?: boolean }[] = [
  { icon: "seal", title: "One signed release", desc: "Everything a robot runs — OS image, applications, configuration, peripheral firmware — pinned under one version and signed with your keys." },
  { icon: "battery", title: "Installs when the robot is ready", desc: "On the charger, not moving, nobody driving it — and, if your fleet asks owners, when the owner picks." },
  { icon: "download", title: "Days of downloading, on a budget", desc: "Only the chunks a robot lacks, resumed after every drop, within a daily data budget that leaves its video alone." },
  { icon: "power", title: "Survives a power cut", desc: "A cut mid-install boots the previous slot; a failed health check rolls back. In the lab: 220 cuts at random moments of an update, on Jetson and x86, every one back on a consistent slot." },
  { icon: "chip", title: "Peripherals too", desc: "GNSS receivers, MCUs on the CAN bus, the site's router — each write verified by reading it back. Handlers in any language." },
  { icon: "layers", title: "Staged by a person", desc: "One robot, then a few, then the rest, promoted by someone watching each stage against the fleet. Abort at any point.", cloud: true },
];

// Section 10: one grid (docs/10, docs/04, ADR-0025).
const trust = [
  { icon: "lock" as const, title: "Encrypted end to end", desc: "Between the machine and the viewer. A relay, when one is needed, only forwards ciphertext." },
  { icon: "ticket" as const, title: "Your backend decides", desc: "A short-lived grant your backend signs, per capability, re-checked by the machine against its own config." },
  { icon: "clock" as const, title: "No static secrets", desc: "Relay credentials are minted per session and expire with the grant." },
  { icon: "shield" as const, title: "Nothing to open", desc: "The machine dials out. No port on the customer's router, no inbound rule for their IT to approve." },
  { icon: "user" as const, title: "Least privilege", desc: "The agent runs as its own unprivileged user; desktop access is narrowed to the screen." },
  { icon: "seal" as const, title: "Signed from repo to robot", desc: "A signed apt repository, and container images signed with an SBOM." },
  { icon: "fanout" as const, title: "One encode, any number of viewers", desc: "A second viewer costs fan-out, not another encoder." },
  { icon: "chip" as const, title: "The integrated GPU first", desc: "Video encodes on the iGPU, so the discrete GPU stays with perception." },
];

// Section 9's snippets: real exported names only (docs/19), claims as docs/09#a-session-grants.
const backendSnippet = `// any JWT library, any language
const grant = jwt.sign({
  aud: "fjarr",
  tenant: "acme",
  robot_id: "robot-024",
  operator: { id: user.email, label: user.name },
  capabilities: [
    { name: "fjarr.camera" },
    { name: "fjarr.desktop" },
  ],
}, GRANT_KEY, { algorithm: "HS256", expiresIn: "5m" });`;
const dashboardSnippet = `import {
  createFjarrClient, FjarrProvider, DesktopView,
} from "@fjarr/react";

const client = createFjarrClient({
  serverUrl: "wss://fjarr.acme.example",
  grant: (id) => myApi.fjarrGrant(id), // your grant endpoint
});

<FjarrProvider client={client}>
  <DesktopView
    session={client.sessions.open("robot-024")} />
</FjarrProvider>`;
---
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fjarr — remote access and updates for the machines you ship</title>
    <meta name="description" content="Live video, the desktop, a terminal and safe over-the-air updates for Linux machines in the field — built into your own product, peer-to-peer and end-to-end encrypted, through any customer network. Open source, or Fjarr Cloud." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ThemeInit />
    <style>
      /* Colours are theme.css tokens only (docs/19#visual-design). */
      :root {
        --text: var(--sl-color-gray-1); --muted: var(--sl-color-gray-2); --faint: var(--sl-color-gray-3);
        --line: var(--sl-color-hairline-light); --line-soft: var(--sl-color-hairline);
        --panel: var(--fj-surface); --accent: var(--sl-color-text-accent); --ok: var(--fj-ok);
      }
      * { box-sizing: border-box; }
      html, body { overflow-x: hidden; }
      body { margin: 0; font-family: var(--sl-font-system, system-ui, sans-serif); background: var(--sl-color-bg); color: var(--muted); line-height: 1.6; -webkit-font-smoothing: antialiased; }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
      a { color: var(--accent); text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); text-underline-offset: 0.2em; }
      a:hover { text-decoration-color: currentColor; }
      h1, h2, h3 { color: var(--sl-color-white); }

      /* Hero: glows, the network field, then the words */
      .hero { position: relative; overflow: hidden; isolation: isolate; }
      .hero::before, .hero::after { content: ""; position: absolute; z-index: -2; pointer-events: none; border-radius: 50%; }
      .hero::before { width: 1100px; height: 900px; left: -380px; top: -520px; background: radial-gradient(closest-side, var(--fj-glow-a), transparent); }
      .hero::after { width: 1000px; height: 800px; right: -420px; top: -160px; background: radial-gradient(closest-side, var(--fj-glow-b), transparent); }
      .hero :global(.network-field) { z-index: -1; }
      .hero-inner { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: center; padding-top: 112px; padding-bottom: 96px; }
      .hero h1 { font-size: clamp(2.2rem, 4.4vw, 3.5rem); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; margin: 0 0 24px; text-wrap: balance; }
      .hero h1 .grad { background: linear-gradient(95deg, var(--sl-color-white) 0%, var(--fj-blue-light) 55%, var(--fj-blue) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .hero p.fit { font-size: 1.25rem; line-height: 1.55; color: var(--text); margin: 0 0 22px; max-width: 36rem; }
      .chips { list-style: none; padding: 0; margin: 0 0 32px; display: flex; flex-wrap: wrap; gap: 8px 22px; }
      .chips li { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-weight: 500; font-size: 0.97rem; }
      .chips li :global(svg) { color: var(--accent); flex: none; }
      .friction { margin: 14px 0 0; color: var(--faint); font-size: 0.9rem; }
      .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
      .cta { display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; border-radius: 10px; font-weight: 600; text-decoration: none; transition: background-color 120ms ease, border-color 120ms ease, box-shadow 120ms ease; }
      .cta.primary { background: var(--fj-blue); color: #fff; box-shadow: 0 0 0 1px color-mix(in srgb, var(--fj-blue) 60%, white 0%), 0 8px 28px -8px color-mix(in srgb, var(--fj-blue) 70%, transparent); }
      .cta.primary:hover { background: color-mix(in srgb, var(--fj-blue) 88%, white); }
      .cta.ghost { border: 1px solid var(--line); color: var(--text); background: color-mix(in srgb, var(--sl-color-bg) 60%, transparent); }
      .cta.ghost:hover { border-color: var(--fj-blue); }
      .release { min-width: 0; background: color-mix(in srgb, var(--sl-color-bg) 72%, transparent); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border: 1px solid var(--line); border-radius: 14px; padding: 20px 22px; box-shadow: 0 24px 60px -30px rgba(0,0,0,0.6); }
      .release .label .badge { text-transform: none; letter-spacing: 0; }
      .release .label { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 12px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--faint); font-weight: 600; }
      .release .meta { color: var(--muted); font-size: 0.95rem; margin: 0 0 4px; }
      .release .meta b { color: var(--ok); }
      .release .after { color: var(--muted); margin: 12px 0 0; font-size: 0.875rem; }

      /* Sections */
      section.wrap { padding-top: 56px; padding-bottom: 56px; }
      h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); line-height: 1.2; letter-spacing: -0.02em; margin: 0 0 14px; }
      h2 small { display: block; font-size: 1.05rem; font-weight: 500; letter-spacing: 0; color: var(--faint); margin-top: 6px; }
      .lede { color: var(--muted); max-width: 52rem; margin: 0 0 28px; font-size: 1.05rem; }
      .note { color: var(--faint); margin: 22px 0 0; font-size: 0.95rem; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; }
      .grid.two { grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr)); }
      .card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 20px; min-width: 0; }
      .card h3 { margin: 0 0 6px; font-size: 1.05rem; line-height: 1.35; }
      .card p { margin: 0; color: var(--muted); font-size: 0.97rem; }
      .card .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 14px; }
      .ic { display: inline-grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; color: var(--accent); background: color-mix(in srgb, var(--fj-blue) 13%, transparent); border: 1px solid color-mix(in srgb, var(--fj-blue) 28%, transparent); flex: none; }
      .card > .ic { margin-bottom: 14px; }
      .badge { font-size: 0.72rem; padding: 2px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--faint); white-space: nowrap; font-weight: 500; }
      .badge.avail { border-color: color-mix(in srgb, var(--ok) 55%, transparent); color: var(--ok); background: color-mix(in srgb, var(--ok) 10%, transparent); }
      code { background: var(--sl-color-bg-inline-code); border: 1px solid var(--line-soft); padding: 1px 6px; border-radius: 5px; font-family: var(--sl-font-system-mono, ui-monospace, monospace); font-size: 0.86em; color: var(--text); overflow-wrap: anywhere; }
      pre { background: var(--fj-code-bg); border: 1px solid var(--line-soft); border-radius: 10px; padding: 14px 16px; margin: 12px 0 0; overflow-x: auto; font-size: 0.85rem; line-height: 1.55; }
      pre code { background: none; border: 0; padding: 0; color: var(--text); overflow-wrap: normal; }
      .card :global(.expressive-code), .release :global(.expressive-code) { margin-top: 12px; }

      /* The problem */
      ul.patchwork { list-style: none; padding: 0; margin: 0 0 22px; display: grid; gap: 10px; }
      ul.patchwork li { background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--fj-warn); border-radius: 10px; padding: 12px 16px; color: var(--muted); }
      ul.patchwork li b { color: var(--text); }

      /* Tier diagram: backend on top, machine ⇄ dashboard below with the direct path between them */
      .tiers-diagram { display: grid; grid-template-columns: 1fr minmax(120px, 0.8fr) 1fr; grid-template-rows: auto auto; gap: 0 12px; align-items: center; margin: 8px 0 28px; }
      .tiers-diagram .node { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 18px; min-width: 0; }
      .tiers-diagram .node h3 { display: flex; align-items: center; gap: 10px; margin: 0 0 8px; font-size: 1.05rem; }
      .tiers-diagram .node h3 .ic { width: 32px; height: 32px; border-radius: 8px; }
      .tiers-diagram .node p { margin: 0; color: var(--muted); font-size: 0.95rem; }
      .tiers-diagram .backend { grid-column: 1 / 4; justify-self: center; max-width: 32rem; text-align: center; }
      .tiers-diagram .backend h3 { justify-content: center; }
      .tiers-diagram .control { grid-column: 1 / 4; display: flex; justify-content: space-between; padding: 0 16%; color: var(--faint); font-size: 0.8rem; }
      .tiers-diagram .control span { border-left: 2px dashed var(--line); padding: 10px 0 10px 8px; }
      .tiers-diagram .machine { grid-column: 1; grid-row: 3; }
      .tiers-diagram .dashboard { grid-column: 3; grid-row: 3; }
      .tiers-diagram .p2p { grid-column: 2; grid-row: 3; text-align: center; color: var(--ok); font-size: 0.85rem; line-height: 1.35; }
      .tiers-diagram .p2p .arrow { display: block; height: 3px; background: var(--ok); border-radius: 2px; margin: 6px 0; position: relative; box-shadow: 0 0 12px color-mix(in srgb, var(--ok) 60%, transparent); }
      .tiers-diagram .p2p .arrow::before, .tiers-diagram .p2p .arrow::after { content: ""; position: absolute; top: -5px; border: 6.5px solid transparent; }
      .tiers-diagram .p2p .arrow::before { left: -6px; border-right-color: var(--ok); border-left: 0; }
      .tiers-diagram .p2p .arrow::after { right: -6px; border-left-color: var(--ok); border-right: 0; }
      .snippets { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr)); gap: 16px; }
      .snippets .card h3 { font-size: 0.95rem; color: var(--muted); font-weight: 600; }

      /* Measured numbers */
      .numbers { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 12px; }
      .numbers a { display: block; text-decoration: none; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; color: inherit; transition: border-color 120ms ease, transform 120ms ease; }
      .numbers a:hover { border-color: var(--fj-blue); }
      .numbers .v { display: block; font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; color: var(--sl-color-white); font-variant-numeric: tabular-nums; line-height: 1.2; }
      .numbers .l { display: block; color: var(--muted); font-size: 0.95rem; }
      .numbers .d { display: block; color: var(--faint); font-size: 0.8rem; margin-top: 4px; }

      /* Fleet OTA: a run, shown like a CI job (docs/32#runs) */
      .ota { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 32px; align-items: start; margin-bottom: 28px; }
      .ota .lede { margin-bottom: 18px; }
      .recipes { color: var(--muted); margin: 0; font-size: 0.97rem; }
      .recipes b { color: var(--text); font-weight: 600; }
      .run { background: var(--fj-code-bg); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; font-size: 0.9rem; }
      .run header { display: flex; justify-content: space-between; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line-soft); color: var(--text); font-weight: 600; }
      .run header span:last-child { color: var(--ok); font-weight: 500; }
      .run ol { list-style: none; margin: 0; padding: 6px 0; }
      .run li { display: grid; grid-template-columns: 20px 7.5rem minmax(0, 1fr); gap: 10px; align-items: baseline; padding: 6px 16px; }
      .run li :global(svg) { color: var(--ok); position: relative; top: 3px; }
      .run .step { color: var(--text); font-weight: 500; }
      .run .what { color: var(--faint); font-family: var(--sl-font-system-mono, ui-monospace, monospace); font-size: 0.82rem; overflow-wrap: anywhere; }
      .cloud { display: inline-block; margin-left: 6px; font-size: 0.72rem; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--faint); font-weight: 500; vertical-align: 2px; }
      ul.features { columns: 2 16rem; padding-left: 1.2rem; color: var(--muted); margin: 0 0 32px; }
      ul.features li { break-inside: avoid; margin-bottom: 6px; }
      ul.features li::marker { color: var(--fj-blue); }
      h3.sub { font-size: 1.2rem; margin: 8px 0 14px; }

      table.tiers { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
      table.tiers td { padding: 14px 18px; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
      table.tiers tr:last-child td { border-bottom: 0; }
      table.tiers td:first-child { white-space: nowrap; color: var(--text); }

      .closing { text-align: center; padding: 72px 0 32px; }
      .closing .ctas { justify-content: center; }
      footer { border-top: 1px solid var(--line-soft); margin-top: 40px; padding: 28px 0 56px; color: var(--faint); text-align: center; font-size: 0.92rem; }


      /* Capabilities: three pillars */
      .pillars { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 16px; }
      .pillar { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 22px; }
      .pillar h3 { margin: 0 0 14px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); }
      .pillar ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
      .pillar li { display: grid; grid-template-columns: 38px minmax(0, 1fr); gap: 12px; align-items: start; }
      .pillar li b { display: block; color: var(--sl-color-white); font-weight: 600; }
      .pillar li span.d { display: block; color: var(--muted); font-size: 0.95rem; }
      .tools { color: var(--muted); margin: 18px 0 0; }

      /* The problem's pull-quote */
      blockquote.founders { margin: 32px 0 0; padding: 18px 24px; border-left: 3px solid var(--fj-blue); background: color-mix(in srgb, var(--fj-blue) 7%, transparent); border-radius: 0 12px 12px 0; }
      blockquote.founders p { margin: 0; color: var(--sl-color-white); font-size: 1.2rem; font-weight: 600; line-height: 1.45; }
      blockquote.founders a { display: inline-block; margin-top: 8px; font-size: 0.95rem; }

      /* Trust: one grid of eight */
      .grid.four { grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
      .card.compact h3 { font-size: 1rem; }
      .card.compact p { font-size: 0.93rem; }
      .tabs-block :global(starlight-tabs) { display: block; }

      @media (max-width: 900px) {
        .ota { grid-template-columns: minmax(0, 1fr); }
        .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 36px; padding-top: 72px; padding-bottom: 64px; }
      }
      @media (max-width: 720px) {
        .wrap { padding-left: 16px; padding-right: 16px; }
        section.wrap { padding-top: 40px; padding-bottom: 40px; }
        .run li { grid-template-columns: 18px 5.6rem minmax(0, 1fr); gap: 8px; padding: 6px 12px; }
        .tiers-diagram { grid-template-columns: 1fr; }
        .tiers-diagram .backend, .tiers-diagram .control, .tiers-diagram .machine, .tiers-diagram .dashboard, .tiers-diagram .p2p { grid-column: 1; grid-row: auto; }
        .tiers-diagram .control { padding: 0 24px; }
        .tiers-diagram .p2p { padding: 10px 0; }
        .tiers-diagram .p2p .arrow { width: 3px; height: 28px; margin: 6px auto; }
        .tiers-diagram .p2p .arrow::before { left: -5px; top: -6px; border: 6.5px solid transparent; border-bottom-color: var(--ok); border-top: 0; }
        .tiers-diagram .p2p .arrow::after { left: -5px; right: auto; top: auto; bottom: -6px; border: 6.5px solid transparent; border-top-color: var(--ok); border-bottom: 0; }
        table.tiers td { display: block; border-bottom: 0; }
        table.tiers tr { display: block; border-bottom: 1px solid var(--line-soft); }
        table.tiers tr:last-child { border-bottom: 0; }
        table.tiers td:first-child { padding-bottom: 0; }
      }
    </style>
  </head>
  <body>
    <SiteHeader />

    <!-- 1. Hero (docs/00, docs/03#who-its-for, docs/04, docs/26) -->
    <header class="hero">
      <NetworkField />
      <div class="hero-inner wrap">
        <div>
          <h1>Remote access and updates for <span class="grad">the machines you ship.</span></h1>
          <p class="fit">
            Stop shipping a VPN and a screen-sharing tool with every machine. Give your team
            live video, the desktop, a terminal and safe updates, inside your product, through
            any customer network.
          </p>
          <ul class="chips">
            <li><FjIcon name="check" size="1.05rem" />Built into your dashboard</li>
            <li><FjIcon name="check" size="1.05rem" />Works behind carrier NAT</li>
            <li><FjIcon name="check" size="1.05rem" />Jetson and x86</li>
          </ul>
          <div class="ctas">
            <a class="cta primary" href="/readme/">Read the docs</a>
            <a class="cta ghost" href="https://github.com/fjarrio/fjarr">GitHub</a>
            {talk && <a class="cta ghost" href={talk}>Talk to us →</a>}
          </div>
          <p class="friction">Open source (AGPL-3.0) or a commercial licence. Self-host free, forever.</p>
        </div>
        <div class="release">
          <p class="label"><span>Install</span><span class="badge avail">v{release}</span></p>
          <p class="meta"><b>v{release} released</b> · Ubuntu 26.04 · amd64 and arm64 · apt or Docker</p>
          <Code code="wget -qO- https://get.fjarr.io | sudo sh" lang="sh" frame="none" />
          <p class="after">
            Then <code>sudo fjarr-agent --check</code>. <a href="/26-robot-install-and-drivers/">Install guide</a>
          </p>
        </div>
      </div>
    </header>

    <!-- 2. The product, running (docs/21, docs/22): absent until the demo loop is recorded. -->

    <!-- 3. The problem (docs/00#the-problem, docs/03#who-its-for, docs/11) -->
    <section class="wrap">
      <h2>What you probably have today</h2>
      <p class="lede">
        Linux on board. Cameras or a screen. Behind someone else's network, far
        from the people who need to see it, drive it and fix it. If that's your
        product, it rarely has no remote access at all — usually a patchwork that kind of works:
      </p>
      <ul class="patchwork">
        <li><b>A VPN or a jump host</b> every engineer has to be set up on — and a second identity system nobody wants to explain to a customer's IT department.</li>
        <li><b>A remote-desktop tool</b> the end customer has to install and approve, that knows nothing about your machine.</li>
        <li><b>A camera stream</b> someone wired to the dashboard one sprint, that falls over on LTE.</li>
        <li><b><code>scp</code> through two hops</b> to get one log out.</li>
        <li>Or <b>"proper remote access"</b>, on the backlog for a year.</li>
      </ul>
      <p class="lede" style="margin:0;">
        Each piece works on a good day. Together they're slow to support, hard to
        secure, and a different login every time. Fjarr replaces the patchwork with
        one connection per machine that carries all of it.
      </p>
      <blockquote class="founders">
        <p>We've built this stack three times before, inside robot companies.</p>
        <a href="/11-prior-art/">What we kept, and what we didn't →</a>
      </blockquote>
    </section>

    <!-- 4. Capabilities (docs/06, docs/05, docs/24, docs/26) -->
    <section class="wrap" id="capabilities">
      <h2>One connection, everything your team needs <small>Every capability is a plugin, including yours</small></h2>
      <div class="pillars">
        {pillars.map((p) => (
          <div class="pillar">
            <h3>{p.title}</h3>
            <ul>
              {p.items.map((c) => (
                <li><span class="ic"><FjIcon name={c.icon} /></span><span><b>{c.name}</b><span class="d">{c.desc}</span></span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="tools">
        And the tools you debug with: the live media pipeline as a graph, <code>fjarr-agent --check</code> with
        the fix for anything missing, and a driver catalog that installs only what the hardware needs.{" "}
        <a href="/06-capabilities/">The full catalog</a> · <a href="/05-extension-model/">write your own</a>
      </p>
    </section>

    <!-- 5. Measured, not promised (docs/16#measured) -->
    <section class="wrap">
      <h2>Measured, not promised</h2>
      <p class="lede">Measured on named hardware at a milestone gate, against a written budget. Click one for where and when.</p>
      <div class="numbers">
        {numbers.map((n) => (
          <a href="/16-performance-budgets/#measured">
            <span class="v">{n.value}</span>
            <span class="l">{n.label}</span>
            <span class="d">{n.detail}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. Updates for the whole fleet (docs/32, docs/06#fjarrota, ADR-0036, ADR-0037) -->
    <section class="wrap">
      <h2>Updates for the whole fleet <small>From the OS image to the GNSS receiver, under one version</small></h2>
      <div class="ota">
        <div>
          <p class="lede">
            Ship a release, and every robot gets onto it safely: when it's charging and
            standing still, without saturating its link, and back on the previous
            version if anything doesn't come up healthy. Every step reads like a CI job,
            live and afterwards, across reboots and offline stretches.
          </p>
          <p class="recipes">
            Reference images for <b>Yocto</b> and <b>NixOS</b> on NVIDIA Jetson and x86,
            an <b>Ubuntu A/B</b> image for x86, and plain <b>apt</b> for the Ubuntu robots
            you already have. Everything on the robot is open source; campaigns across a
            fleet are Fjarr Cloud.
          </p>
        </div>
        <div class="run" role="img" aria-label="An update run shown step by step: fetch, ready, prepare, install, switch, health, peripherals, commit and firmware, each succeeded.">
          <header><span>robot-024 → release 1.2</span><span>succeeded</span></header>
          <ol>
            {runSteps.map(([step, what]) => (
              <li><FjIcon name="check" size="1rem" /><span class="step">{step}</span><span class="what">{what}</span></li>
            ))}
          </ol>
        </div>
      </div>
      <div class="grid">
        {ota.map((t) => (
          <div class="card"><span class="ic"><FjIcon name={t.icon} /></span><h3>{t.title}{t.cloud && <span class="cloud">Fjarr Cloud</span>}</h3><p>{t.desc}</p></div>
        ))}
      </div>
      <p class="note">The design, step by step: <a href="/32-fleet-ota/">fleet updates</a> · <a href="/32-fleet-ota/#runs">run logs</a> · <a href="/32-fleet-ota/#peripherals">peripheral handlers</a>.</p>
    </section>

    <!-- 7. The desktop, and control that's safe for a moving machine (docs/22, docs/08, docs/15) -->
    <section class="wrap">
      <h2>Taking control stops the robot first <small>The machine's own desktop in your dashboard — with control that's safe for one that moves</small></h2>
      <p class="lede">
        Driving is one operator at a time and never handed over on idle; taking it over
        releases every input before anyone new can move it. And the desktop is the one the
        machine already has, with no tool for the end customer to install:
      </p>
      <ul class="features">
        <li>Unattended: back after a reboot with nobody at the machine</li>
        <li>Every monitor, plugged in or out while you watch</li>
        <li>Virtual screens for machines with no monitor attached</li>
        <li>The clipboard both ways</li>
        <li>Typing through the machine's own keyboard layout</li>
        <li>Its own cursor, drawn where it really is</li>
      </ul>
      <div class="grid">
        <div class="card"><span class="ic"><FjIcon name="pointer" /></span><h3>One pointer, handed over cleanly</h3><p>Desktop control frees five seconds after the holder's last input, or anyone takes it at once — and the holder is told.</p></div>
        <div class="card"><span class="ic"><FjIcon name="heartbeat" /></span><h3>Gone means released</h3><p>If an operator's connection dies, their held keys and buttons are released. A machine is never left stuck.</p></div>
        <div class="card"><span class="ic"><FjIcon name="eye" /></span><h3>Watch without touching</h3><p>A view-only grant can never take control or read the clipboard — for the customer, the auditor, the second pair of eyes.</p></div>
      </div>
      <p class="note">Each of these ships with a regression test (<a href="/15-testing-strategy/#safety-behaviors">safety behaviors</a>). How control works: <a href="/22-remote-desktop-client/">remote desktop</a>.</p>
    </section>

    <!-- 8. A link to one machine (docs/03#tunnel-positioning, docs/27, docs/29) -->
    <section class="wrap">
      <h2>A link to one machine <small>ssh, ROS 2 and your debugger, straight to the robot</small></h2>
      <p class="lede">
        An authorized operator gets a routable address for <b>one</b> machine, inside the session
        that already carries its video — and the tools they already use just work.
      </p>
      <Code lang="console" code={connectSession} />
      <div class="grid two" style="margin-top:16px;">
        {tunnelUses.map((u) => (
          <div class="card">
            <h3>{u.title}</h3>
            <p>{u.desc}</p>
            <Code code={u.code} lang="sh" frame="none" />
            <p style="margin-top:10px;font-size:0.875rem;"><a href={u.href}>How-to →</a></p>
          </div>
        ))}
      </div>
      <p class="note">
        And ssh, scp, RDP, a serial port, Modbus, Foxglove — <a href="/28-tunnel-ideas/">more ideas</a>.
        Each link reaches one machine, under the same grant and audit log as everything else,
        and is gone when the session ends; two machines never see each other (<a href="/27-network-tunnel/">the design</a>).
      </p>
    </section>

    <!-- 9. How it fits your stack (docs/02, docs/09) -->
    <section class="wrap">
      <h2>How it fits your stack</h2>
      <p class="lede">Fjarr embeds into what you already run. Your backend stays in charge of who may reach what; video and data go straight between the machine and the person looking at it.</p>
      <div class="tiers-diagram" role="img" aria-label="Your backend, with the fjarr-server sidecar, issues grants and handles signaling for the machine and the dashboard. Media and data flow directly between the machine and the dashboard, peer-to-peer.">
        <div class="node backend">
          <h3><span class="ic"><FjIcon name="server" size="1.1rem" /></span>Next to your backend</h3>
          <p>The <code>fjarr-server</code> sidecar, beside a backend in any language. Your backend signs grants and receives webhooks. It never touches the media.</p>
        </div>
        <div class="control"><span>signaling</span><span>grants · signaling</span></div>
        <div class="node machine">
          <h3><span class="ic"><FjIcon name="robot" size="1.1rem" /></span>On the machine</h3>
          <p>Embed <code>libfjarr</code> (C++/GStreamer) in your software, or run the <code>fjarr-agent</code> daemon beside it. Hardware encode.</p>
        </div>
        <div class="p2p">
          peer-to-peer
          <span class="arrow"></span>
          encrypted · relay only<br />when nothing else works
        </div>
        <div class="node dashboard">
          <h3><span class="ic"><FjIcon name="dashboard" size="1.1rem" /></span>In your dashboard</h3>
          <p><code>@fjarr/core</code> + <code>@fjarr/react</code> in the dashboard you already have — standard WebRTC, any modern browser. Headless-first: your design system wins.</p>
        </div>
      </div>
      <div class="tabs-block">
        <Tabs>
          <TabItem label="Your backend: who may open what">
            <Code code={backendSnippet} lang="js" />
          </TabItem>
          <TabItem label="Your dashboard: mount it">
            <Code code={dashboardSnippet} lang="tsx" />
          </TabItem>
        </Tabs>
      </div>
      <p class="note">The contract between the pieces: <a href="/09-interfaces/">interfaces</a> · <a href="/02-architecture/">architecture</a></p>
    </section>

    <!-- 10. Trust (docs/10, docs/04, ADR-0025) -->
    <section class="wrap">
      <h2>Safe on a customer's network</h2>
      <div class="grid four">
        {trust.map((t) => (
          <div class="card compact"><span class="ic"><FjIcon name={t.icon} /></span><h3>{t.title}</h3><p>{t.desc}</p></div>
        ))}
      </div>
      <p class="note">The whole threat model is public: <a href="/10-security/">security</a>. Encoders and hardware: <a href="/04-supported-platforms/">supported platforms</a>.</p>
    </section>

    <!-- 11. Open core and Fjarr Cloud (docs/03, ADR-0011) -->
    <section class="wrap" id="cloud">
      <h2>Open core and Fjarr Cloud</h2>
      <table class="tiers">
        <tr><td><b>Free &amp; open</b></td><td>All three libraries, the signaling sidecar, the network link and its client, everything that updates a robot, the protocol, the docs, the demos. Usable alone, self-hosted forever.</td></tr>
        <tr><td><b>Fjarr Cloud</b></td><td>Managed signaling and relays, fleet observability, staged update campaigns, SSO — the same contract as self-hosting, so you can switch either way. In early access: {talk ? <a href={talk}>tell us your fleet size</a> : "tell us your fleet size"}.</td></tr>
        <tr><td><b>Licence</b></td><td>AGPL-3.0, or a commercial licence when AGPL doesn't fit your product. Nothing we ship depends on GPL code, and the build environment refuses it.</td></tr>
      </table>
      <p class="note">The whole business plan is a public document: <a href="/03-product-strategy/">product strategy</a>.</p>
    </section>

    <!-- 12. Closing and footer (docs/26) -->
    <section class="wrap closing">
      <h2>See if it fits</h2>
      <p class="lede" style="margin:0 auto 28px;">The specs are the product's source of truth, and they're all public.</p>
      <div class="ctas">
        <a class="cta primary" href="/readme/">Read the docs</a>
        {talk ? <a class="cta ghost" href={talk}>Talk to us →</a> : <a class="cta ghost" href="https://github.com/fjarrio/fjarr">GitHub</a>}
      </div>
    </section>

    <footer>
      <div class="wrap">
        Fjarr · <a href="/readme/">documentation</a> · <a href="https://github.com/fjarrio/fjarr">GitHub</a>{" "}
        {contact && <>· <a href={talk}>{contact}</a>{" "}</>}
        · v{release} on apt stable: <a href="/26-robot-install-and-drivers/">install</a>{" "}
        · built documentation-first in Sweden 🇸🇪 · <i>Fjärr</i> is Swedish for "remote"
      </div>
    </footer>
  </body>
</html>
