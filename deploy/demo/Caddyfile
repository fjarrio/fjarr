# The hosted demo's reverse proxy (docs/31-hosted-demo.md). Cloudflare connects here with the visitor's
# Host; both names present the Cloudflare Origin CA certificate (no ACME: the server's 443 is open to
# Cloudflare only).
{
	admin off
	auto_https disable_redirects
}

demo.fjarr.io {
	tls /certs/origin.pem /certs/origin.key
	encode gzip
	handle /api/* {
		reverse_proxy 127.0.0.1:9090
	}
	handle {
		root * /srv/demo
		try_files {path} /index.html
		file_server
	}
}

signal.fjarr.io {
	tls /certs/origin.pem /certs/origin.key
	reverse_proxy 127.0.0.1:8080
}
