# fjarr's CMake package, for robot software embedding libfjarr: find_package(fjarr) → fjarr::fjarr.
# libfjarr is static in 0.x (docs/26#packages), so its private dependencies are link dependencies of
# yours: they are found here. spec: docs/09-interfaces.md · docs/26-robot-install-and-drivers.md
@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
pkg_check_modules(GST REQUIRED IMPORTED_TARGET
  gstreamer-1.0>=1.24 gstreamer-app-1.0 gstreamer-video-1.0 gstreamer-webrtc-1.0 gstreamer-sdp-1.0)
pkg_check_modules(SOUP REQUIRED IMPORTED_TARGET libsoup-3.0>=3.4)
pkg_check_modules(SYSTEMD REQUIRED IMPORTED_TARGET libsystemd)
find_dependency(nlohmann_json 3.11)
find_dependency(tomlplusplus 3.4)
include("${CMAKE_CURRENT_LIST_DIR}/fjarrTargets.cmake")
check_required_components(fjarr)
